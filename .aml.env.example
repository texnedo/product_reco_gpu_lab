# Copy this file to a name ending in .aml.env and fill in your workspace values.
# Files ending in .aml.env are intentionally ignored by Git.
export AZURE_SUBSCRIPTION_ID="<subscription-id>"
export AZURE_RESOURCE_GROUP="<resource-group>"
export AZURE_ML_WORKSPACE="<workspace-name>"
export AZURE_ML_COMPUTE="<compute-name>"

# Optional job defaults.
export AZURE_ML_EXPERIMENT="product-reranker"
export AZURE_ML_ENVIRONMENT="AzureML-acpt-pytorch-2.8-cuda12.6@latest"

# Optional overrides for the portable paths in config/assets.yaml.
# export ESCI_DATA_PATH="/path/to/esci-data/shopping_queries_dataset"
# export QWEN_MODEL_PATH="/path/to/Qwen3-Reranker-0.6B"

